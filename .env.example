# ══════════════════════════════════════════════════════════════════════════════
# TradePilot 环境变量模板
# 复制为 .env.local 后填入真实值，.env.local 已在 .gitignore 中，不会上传
# ══════════════════════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────────────────────────
# 本地开发：使用本地 SQLite 文件
# DATABASE_URL="file:./dev.db"
#
# Vercel 生产：使用 Turso（libSQL 云端 SQLite）
# 1. 注册 https://turso.tech（免费）
# 2. turso db create tradepilot
# 3. turso db show tradepilot  → 复制 URL
# 4. turso db tokens create tradepilot  → 复制 Token
DATABASE_URL="libsql://your-db-name.turso.io"

# ── Turso 认证 Token（仅 Vercel 生产需要）────────────────────────────────────
# 本地开发留空即可（DATABASE_URL=file:./dev.db 时不使用此 Token）
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── NextAuth ─────────────────────────────────────────────────────────────────
# 生成随机密钥：openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
# 本地开发
# NEXTAUTH_URL=http://localhost:3000
# Vercel 生产（替换为你的域名）
NEXTAUTH_URL=https://your-domain.vercel.app

# ── DashScope（千问，保留作为 fallback）──────────────────────────────────────
# 若 OpenRouter 请求失败，自动降级到此 key 调用 qwen-max / qwen-plus
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter 多模型路由 ─────────────────────────────────────────────────────
# 主路由：优先于 DashScope 使用
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 前端显示 TP-CORE（FREE tier）
# 示例：qwen/qwen3-235b-a22b:free  /  meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FREE_MODEL=qwen/qwen3-235b-a22b:free

# 前端显示 TP-MAX（VIP tier）
# 示例：anthropic/claude-sonnet-4-5  /  google/gemini-2.5-pro
OPENROUTER_VIP_MODEL=anthropic/claude-sonnet-4-5

# 前端显示 TP-ULTRA（ULTRA tier）
# 示例：anthropic/claude-opus-4-5  /  openai/gpt-4o
OPENROUTER_ULTRA_MODEL=anthropic/claude-opus-4-5

# ── OpenRouter 灰度开关 ───────────────────────────────────────────────────────
# ENABLED=false  → 全部走 DashScope（默认安全状态）
# ENABLED=true   → 按 ADMIN_IDS 白名单 + ROLLOUT_PCT 灰度决定是否走 OpenRouter
OPENROUTER_ENABLED=false

# 管理员白名单（逗号分隔 userId），命中即走 OpenRouter（无视 ENABLED 总开关）
# 用途：管理员账号单独测试，不影响其他用户
# 示例：OPENROUTER_ADMIN_IDS=clxxxxxx,clyyyyyy
OPENROUTER_ADMIN_IDS=

# 非管理员灰度百分比（0-100），0 = 不扩量，100 = 全量
# 建议：Phase 1 保持 0，Phase 2 设为 5，Phase 3 设为 100
OPENROUTER_ROLLOUT_PCT=0

# ── 站点 URL（OpenRouter HTTP-Referer 头使用）────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── 内测模式开关 ──────────────────────────────────────────────────────────────
# true  → 隐藏付费入口，显示"内测期间免费体验"横幅（邀请好友内测时使用）
# false → 显示正常付费页面（正式上线后改为 false）
NEXT_PUBLIC_BETA_MODE=true

# ── 种子邀请码（管理员注册用）────────────────────────────────────────────────
# 使用此码注册的用户成为顶级节点（无上级代理），不触发邀请奖励
# 建议设置为一个随机字符串，仅自己知道
SEED_INVITE_CODE=your-secret-seed-code
